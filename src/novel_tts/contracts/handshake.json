{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "host",
    "port",
    "pid"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "host": {
      "const": "127.0.0.1"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    }
  }
}
